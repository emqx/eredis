{erl_opts, [
  {platform_define, "^[0-9]+", namespaced_types}
]}.
{deps, [
  {gproc, "1.0.0"}
]}.
{cover_enabled, true}.
%% basho_bench_driver_erldis calls undefined functions, so disable xref_checks.
%% This allows this project to be used as a dependency by other rebar projects
%% that use xref.
{xref_checks, []}.
