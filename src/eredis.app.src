%% -*- mode: erlang -*-
{application, eredis, [
    {description, "Erlang Redis Client"},
    {vsn, "git"},
    {modules, [eredis_app,
               eredis_sup,
               eredis,
               eredis_client,
               eredis_parser,
               eredis_sub,
               eredis_sub_client,
               eredis_sentinel,
               eredis_sentinel_client,
               eredis_sentinel_masters,
               eredis_sentinel_registry,
               eredis_sentinel_sup]},
    {registered, [eredis_sup]},
    {applications, [kernel, stdlib, gproc]},
    {mod, {eredis_app, []}}
]}.
